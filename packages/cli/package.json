    "url": "https://github.com/fk0u/ruas/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.3",
    "picocolors": "^1.1.1",
    "tree-sitter-wasms": "^0.1.13",
